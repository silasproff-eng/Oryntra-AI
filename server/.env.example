PORT=8001
PUBLIC_API_BASE_URL=http://127.0.0.1:8001
PUBLIC_BASE_URL=http://127.0.0.1:8001

# Leave platform provider keys blank for the public browser-direct flow.
# Users connect their own key locally in their browser; Oryntra never receives it.
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
ORYNTRA_POLYGON_CALLS_PER_MINUTE=5
ORYNTRA_POLYGON_MIN_GAP=12.5

ORYNTRA_MARKET_DATA_LICENSE_MODE=personal_research
ORYNTRA_OWNER_EMAILS=owner@example.com
ORYNTRA_PUBLIC_DERIVED_ANALYSIS_ENABLED=false
# Set business_approved and true only after the applicable provider and exchange
# licenses allow public derived analysis for your specific product.
# ORYNTRA_MARKET_DATA_LICENSE_MODE=business_approved
# ORYNTRA_PUBLIC_DERIVED_ANALYSIS_ENABLED=true

# Opt-in public browser-direct analysis. This accepts normalized bars from an
# authenticated browser, never a provider API key, and does not persist raw bars.
ORYNTRA_BROWSER_DIRECT_ANALYSIS_ENABLED=false

ORYNTRA_SUBSCRIPTIONS_ENFORCED=false
ORYNTRA_DAILY_ANALYSIS_LIMIT=100
ORYNTRA_PLAN_DISPLAY_PRICE_USD=3.00
ORYNTRA_ALLOW_MANUAL_BETA_SUBSCRIPTIONS=false

ORYNTRA_PUBLIC_SCANNER_WEBSITE=true
ORYNTRA_PRIVATE_RESEARCH_ROUTES=false
# Set true to expose the browser-direct Quant Lab to signed-in users.
ORYNTRA_PUBLIC_QUANT_LAB_ENABLED=false
ORYNTRA_CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

ORYNTRA_ANALYSIS_RESULT_TTL=90
ORYNTRA_ANALYSIS_CACHE_MAX_ITEMS=256
ORYNTRA_SCAN_CONCURRENCY=3
ORYNTRA_SCAN_LOOKBACK_BARS=320
ORYNTRA_PATTERN_LOOKBACK_BARS=180

ORYNTRA_MARKET_CACHE_AUTO_START=false
ORYNTRA_MARKET_CACHE_AUTO_BACKFILL=false
ORYNTRA_MARKET_CACHE_POLL_SECONDS=1800
ORYNTRA_MARKET_CACHE_INITIAL_DELAY_SECONDS=15
ORYNTRA_MARKET_CACHE_EOD_READY_HOUR_ET=18
ORYNTRA_MARKET_CACHE_UPDATE_SESSIONS=5
ORYNTRA_MARKET_CACHE_SYNC_REFERENCE=true
ORYNTRA_MARKET_CACHE_REFERENCE_REFRESH_DAYS=7
ORYNTRA_MARKET_CACHE_MIN_ROWS=1000
ORYNTRA_MARKET_CACHE_LOOKBACK_DAYS=730
ORYNTRA_MARKET_CACHE_RETENTION_DAYS=0

ORYNTRA_RESEARCH_MAX_UNIVERSE=15000
ORYNTRA_PATTERN_LAB_CPU_SHARE=0.30
ORYNTRA_PATTERN_LAB_NICE=12
ORYNTRA_PATTERN_LAB_CHECKPOINT_TICKERS=5
ORYNTRA_PATTERN_LAB_MAX_BOOTSTRAP=300
ORYNTRA_PATTERN_LAB_MAX_RETURNED_ROWS=20000
