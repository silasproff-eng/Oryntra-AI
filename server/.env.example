# Oryntra AI v0.7.0 — Alpaca Connect production template
# Copy to .env, fill in the values, and never commit or share .env.

# Keep the maintenance website on 8000 and run the mobile API on 8001.
PORT=8001

# Public HTTPS address of this API. It must be reachable by Alpaca and the app.
PUBLIC_API_BASE_URL=https://api.oryntraai.com
PUBLIC_BASE_URL=https://oryntraai.com

# Alpaca Connect credentials supplied after your application is approved.
# The client secret belongs ONLY on this server, never in Flutter/Xcode/GitHub.
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=

# This exact URI must also be registered in the Alpaca Connect dashboard.
ALPACA_OAUTH_REDIRECT_URI=https://api.oryntraai.com/api/alpaca/callback

# Generate once with: python tools/generate_token_encryption_key.py
# Keep the same value across restarts or stored Alpaca tokens cannot be decrypted.
ORYNTRA_TOKEN_ENCRYPTION_KEY=

# IEX is the conservative default. Use another feed only when your Alpaca
# agreement/account explicitly grants it.
ALPACA_DATA_FEED=iex

# Comma-separated browser origins. Native iOS requests are not governed by CORS.
ORYNTRA_CORS_ORIGINS=https://oryntraai.com

# Public deployments MUST leave this false. Enabling it mounts legacy research,
# Polygon/cache, Pattern Lab, backtest, and developer routes.
ORYNTRA_PRIVATE_RESEARCH_ROUTES=false

# Optional private-research Polygon key. Never set this on the public API host.
POLYGON_API_KEY=

# Private research/cache settings only. They are inert while private routes=false.
ORYNTRA_MARKET_CACHE_AUTO_START=false
ORYNTRA_MARKET_CACHE_AUTO_BACKFILL=false
ORYNTRA_MARKET_CACHE_POLL_SECONDS=1800
ORYNTRA_MARKET_CACHE_INITIAL_DELAY_SECONDS=15
ORYNTRA_MARKET_CACHE_EOD_READY_HOUR_ET=18
ORYNTRA_MARKET_CACHE_UPDATE_SESSIONS=5
ORYNTRA_MARKET_CACHE_SYNC_REFERENCE=true
ORYNTRA_MARKET_CACHE_REFERENCE_REFRESH_DAYS=7
ORYNTRA_MARKET_CACHE_MIN_ROWS=1000
ORYNTRA_MARKET_CACHE_LOOKBACK_DAYS=730
ORYNTRA_MARKET_CACHE_RETENTION_DAYS=0

# Isolated private Pattern Lab defaults.
ORYNTRA_RESEARCH_MAX_UNIVERSE=15000
ORYNTRA_PATTERN_LAB_CPU_SHARE=0.30
ORYNTRA_PATTERN_LAB_NICE=12
ORYNTRA_PATTERN_LAB_CHECKPOINT_TICKERS=5
ORYNTRA_PATTERN_LAB_MAX_BOOTSTRAP=300
ORYNTRA_PATTERN_LAB_MAX_RETURNED_ROWS=20000

# Analysis performance.
ORYNTRA_ANALYSIS_RESULT_TTL=90
ORYNTRA_ANALYSIS_CACHE_MAX_ITEMS=256
ORYNTRA_SCAN_CONCURRENCY=3
ORYNTRA_SCAN_LOOKBACK_BARS=320
ORYNTRA_PATTERN_LOOKBACK_BARS=180
